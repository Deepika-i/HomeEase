{
  "expo": {
    "name": "HomeEase",
    "slug": "HomeEase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/homeease-icon-page-match.png",
    "scheme": "homeease",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/homeease-icon-page-match.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF2E6",
        "foregroundImage": "./assets/images/homeease-icon-page-match.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deepika_04.HomeEase"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2c8b63ff-e8cf-4d7a-b3cb-162cefd82c90"
      }
    }
  }
}